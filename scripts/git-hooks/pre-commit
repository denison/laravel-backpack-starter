#!/usr/bin/env bash

set -e

echo "Running Laravel Pint style check..."

docker compose exec -T app-dev composer format

if ! git diff --quiet; then
    echo ""
    echo "Laravel Pint found style issues and autoformatted the code."
    echo "Review the changes, stage them, and try the commit again:"
    echo ""
    echo "  git diff"
    echo "  git add ."
    echo "  git commit"
    echo ""
    exit 1
fi

echo "Laravel Pint style check passed."
